# ---------------------------------------------------------------------------
# Copy to api/.env and set what you need:   cp api/.env.example api/.env
#
# Every value here is optional. With no .env at all the app runs fully offline
# on the local lexical embedder and the echo answerer - nothing is required to
# get it working. Real environment variables always beat this file, so a
# deployment cannot be overridden by a stray .env in the image.
#
# Values shown commented out are the defaults.
# ---------------------------------------------------------------------------


# ===========================================================================
# AI providers - the only two settings most people need
# ===========================================================================

# Answers. Set this and ANSWER_PROVIDER becomes "anthropic" automatically.
# Leave it blank to use "echo", which returns the top retrieved passage with a
# notice instead of a generated answer.
ANTHROPIC_API_KEY=

# Embeddings. Set this and EMBEDDING_PROVIDER becomes "openai" automatically.
#
# THIS IS THE ONE THAT DECIDES SEARCH QUALITY. Without it you get lexical
# matching: it finds "budget cap" from "budget caps", but never "invoice
# deadline" from "when is payment due". If questions phrased in your own words
# return nothing, this is why. Run `npm run doctor -- "your question"` to
# confirm before changing anything else.
OPENAI_API_KEY=

# Changing either provider is safe: each chunk records the embedding that
# produced it, and anything stale is re-embedded from its stored text on the
# next start. No refetch, no need to delete the database or re-save items.


# ===========================================================================
# Provider details
# ===========================================================================

# ANSWER_PROVIDER=anthropic            # anthropic | echo
# ANTHROPIC_MODEL=claude-opus-5
# ANSWER_MAX_TOKENS=2000
# ANSWER_EFFORT=low                    # low | medium | high | xhigh | max
                                       #   grounded Q&A over a few short chunks
                                       #   is not deep reasoning; raise for
                                       #   harder corpora at the cost of latency
# ANSWER_TIMEOUT_SECONDS=60

# EMBEDDING_PROVIDER=openai            # openai | local
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
                                       #   point at any OpenAI-compatible
                                       #   embeddings endpoint
# EMBEDDING_BATCH_SIZE=64              # documents per /embeddings request
# EMBEDDING_TIMEOUT_SECONDS=30
# LOCAL_EMBEDDING_DIMENSIONS=2048      # keyless embedder only. Was 512, which
                                       #   collided often enough that unrelated
                                       #   chunks outranked correct ones.


# ===========================================================================
# Server
# ===========================================================================

# PORT=8787
# CORS_ORIGINS=http://localhost:5173   # comma-separated
# APP_ENV=development
# LOG_LEVEL=info                       # debug | info | warning | error
# LOG_PRETTY=true                      # false emits JSON lines for a log shipper
# DB_FILE=./data/knowledge-inbox.db    # defaults to api/data/knowledge-inbox.db.
                                       #   A relative path here resolves against
                                       #   the working directory, not this file,
                                       #   so prefer an absolute path unless you
                                       #   always start from api/.
                                       #   ':memory:' for a throwaway instance.


# ===========================================================================
# Ingestion
# ===========================================================================

# INGEST_CONCURRENCY=2                 # background workers fetching + embedding
# MAX_NOTE_CHARS=100000

# URL_FETCH_TIMEOUT_SECONDS=10
# URL_FETCH_MAX_BYTES=2000000          # enforced while streaming, not after
# URL_FETCH_MAX_REDIRECTS=3
# URL_FETCH_USER_AGENT=KnowledgeInboxBot/1.0 (+https://example.invalid)

# URL_FETCH_ALLOW_PRIVATE=false        # DANGER: true disables the SSRF guard,
                                       #   letting saved URLs reach localhost,
                                       #   RFC1918, and cloud metadata endpoints
                                       #   (169.254.169.254). Local testing only.


# ===========================================================================
# Chunking and retrieval
# ===========================================================================

# CHUNK_TARGET_CHARS=1000              # ~250 tokens: big enough for one whole
                                       #   idea, small enough to be mostly signal
# CHUNK_OVERLAP_CHARS=150              # keeps a fact that straddles a boundary
                                       #   retrievable from both sides
# CHUNK_MIN_CHARS=120                  # a trailing chunk shorter than this is
                                       #   merged into its predecessor

# RETRIEVAL_TOP_K=5                    # chunks sent to the model per question
# RETRIEVAL_MAX_TOP_K=20               # ceiling a client may request
# RETRIEVAL_MAX_PER_ITEM=3             # stops one long article filling every slot
# RETRIEVAL_MAX_CONTEXT_CHARS=12000    # hard ceiling on prompt context

# RETRIEVAL_MIN_SCORE=                 # unset = each provider's own floor
                                       #   (local 0.10, openai 0.15), because
                                       #   lexical and dense scores are not on
                                       #   the same scale. Chunks below the floor
                                       #   are not discarded - they are answered
                                       #   over at low confidence, flagged in
                                       #   the UI. Raise to be stricter, lower
                                       #   to surface more weak matches.
